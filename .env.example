# 必填（compose 强校验）
API_SERVER_KEY=change-me-long-random-key

# dashboard 认证：不设则 9119 登录 fail-closed（实测数据端点无凭据 401）；PASSWORD_HASH 优先于 PASSWORD
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me-strong-password
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=scrypt$...
# HERMES_DASHBOARD_BASIC_AUTH_SECRET=random-32-bytes
# HERMES_DASHBOARD_OAUTH_CLIENT_ID=

# 可选
HERMES_UID=10000
HERMES_GID=10000
WEBUI_PORT=8787
DASHBOARD_PORT=9119
GATEWAY_PORT=8642
# webui 会话密码（留空则仅本机可用）
# HERMES_WEBUI_PASSWORD=

IMAGE=ghcr.io/lgc2333/hermes-webui-all-in-one
TAG=latest
